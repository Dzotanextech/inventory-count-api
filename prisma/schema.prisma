generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum InventoryCountStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  RECOUNT
}

enum InventoryCountType {
  FULL
  CATEGORY
  PRODUCT
  RACK
  CYCLE
}

enum ApprovalAction {
  SUBMIT
  APPROVE
  REJECT
  RECOUNT
}

// ─── Auth & Users ─────────────────────────────────────────────────────────────

model Role {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  users User[]

  @@map("roles")
}

model User {
  id           String   @id @default(uuid())
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens       RefreshToken[]
  createdCounts       InventoryCount[]     @relation("CreatedBy")
  submittedCounts     InventoryCount[]     @relation("SubmittedBy")
  approvedCounts      InventoryCount[]     @relation("ApprovedBy")
  countedItems        InventoryCountItem[]
  approvals           Approval[]
  auditLogs           AuditLog[]

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Warehouse Structure ───────────────────────────────────────────────────────

model Warehouse {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zones              Zone[]
  inventoryLocations InventoryLocation[]
  inventoryCounts    InventoryCount[]

  @@map("warehouses")
}

model Zone {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  code        String
  name        String

  racks Rack[]

  @@unique([warehouseId, code])
  @@map("zones")
}

model Rack {
  id       String  @id @default(uuid())
  zoneId   String
  zone     Zone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  rackCode String
  barcode  String  @unique
  binCount Int     @default(1)
  isActive Boolean @default(true)

  inventoryLocations  InventoryLocation[]
  inventoryCountItems InventoryCountItem[]

  @@unique([zoneId, rackCode])
  @@map("racks")
}

// ─── Products & Categories ────────────────────────────────────────────────────

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id             String   @id @default(uuid())
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  sku            String   @unique
  barcode        String   @unique
  name           String
  description    String?
  uom            String
  costPrice      Decimal  @db.Decimal(12, 4)
  sellingPrice   Decimal  @db.Decimal(12, 4)
  isBatchTracked Boolean  @default(false)

  batches             Batch[]
  inventoryLocations  InventoryLocation[]
  inventoryCountItems InventoryCountItem[]

  @@index([sku])
  @@index([barcode])
  @@index([categoryId])
  @@map("products")
}

model Batch {
  id                String    @id @default(uuid())
  productId         String
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNumber       String
  manufacturingDate DateTime?
  expiryDate        DateTime?

  inventoryLocations  InventoryLocation[]
  inventoryCountItems InventoryCountItem[]

  @@unique([productId, batchNumber])
  @@index([productId])
  @@map("batches")
}

// ─── Inventory Locations ──────────────────────────────────────────────────────

model InventoryLocation {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  rackId      String?
  rack        Rack?     @relation(fields: [rackId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  batchId     String?
  batch       Batch?    @relation(fields: [batchId], references: [id])
  quantity    Decimal   @default(0) @db.Decimal(12, 4)

  @@index([warehouseId])
  @@index([productId])
  @@index([rackId])
  @@map("inventory_locations")
}

// ─── Inventory Counts ─────────────────────────────────────────────────────────

model InventoryCount {
  id                 String               @id @default(uuid())
  countNumber        String               @unique
  warehouseId        String
  warehouse          Warehouse            @relation(fields: [warehouseId], references: [id])
  countType          InventoryCountType
  status             InventoryCountStatus @default(DRAFT)
  countDate          DateTime
  dueDate            DateTime?
  createdById        String
  createdBy          User                 @relation("CreatedBy", fields: [createdById], references: [id])
  submittedById      String?
  submittedBy        User?                @relation("SubmittedBy", fields: [submittedById], references: [id])
  approvedById       String?
  approvedBy         User?                @relation("ApprovedBy", fields: [approvedById], references: [id])
  startedAt          DateTime?
  submittedAt        DateTime?
  approvedAt         DateTime?
  totalVarianceValue Decimal              @default(0) @db.Decimal(14, 2)
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  items     InventoryCountItem[]
  approvals Approval[]

  @@index([warehouseId])
  @@index([status])
  @@index([countType])
  @@map("inventory_counts")
}

model InventoryCountItem {
  id               String         @id @default(uuid())
  inventoryCountId String
  inventoryCount   InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  batchId          String?
  batch            Batch?         @relation(fields: [batchId], references: [id])
  rackId           String?
  rack             Rack?          @relation(fields: [rackId], references: [id])
  systemQty        Decimal        @default(0) @db.Decimal(12, 4)
  physicalQty      Decimal?       @db.Decimal(12, 4)
  varianceQty      Decimal?       @db.Decimal(12, 4)
  varianceValue    Decimal?       @db.Decimal(14, 2)
  reason           String?
  remarks          String?
  countedById      String?
  countedBy        User?          @relation(fields: [countedById], references: [id])
  countedAt        DateTime?

  @@index([inventoryCountId])
  @@index([productId])
  @@map("inventory_count_items")
}

// ─── Approvals ────────────────────────────────────────────────────────────────

model Approval {
  id               String         @id @default(uuid())
  inventoryCountId String
  inventoryCount   InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  action           ApprovalAction
  remarks          String?
  performedById    String
  performedBy      User           @relation(fields: [performedById], references: [id])
  createdAt        DateTime       @default(now())

  @@index([inventoryCountId])
  @@map("approvals")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id            String   @id @default(uuid())
  entityType    String
  entityId      String
  action        String
  oldValue      Json?
  newValue      Json?
  performedById String
  performedBy   User     @relation(fields: [performedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([performedById])
  @@index([createdAt])
  @@map("audit_logs")
}
